# ──────────────────────────────────────────────────────────────
# genie platform — root environment template
# Copy to .env for local development. .env is git-ignored.
# Each app also reads these; app-specific overrides live in apps/*/.env.local
# ──────────────────────────────────────────────────────────────

# --- Runtime -------------------------------------------------
NODE_ENV="development"
APP_ENV="local"            # local | preview | production

# Consumer web base for wishlist share links + referral links. Defaults to the
# deployed landing site; set this for local dev so links point at your machine.
APP_PUBLIC_URL="http://localhost:3000"

# --- Database (Neon Postgres) ------------------------------------
# Create a project at https://neon.tech and copy both connection strings.
# DATABASE_URL  = pooled connection  ("-pooler" host) — used by apps/api at runtime
# DIRECT_URL    = direct connection  (no "-pooler")   — used by Prisma migrate / studio
#
# NOTE: the Next.js apps (apps/admin) read their OWN apps/*/.env.local and point
# DATABASE_URL at the DIRECT connection — Prisma's binary engine over Neon's
# pooler is flaky inside the Next dev server. For Vercel, use the Neon serverless
# driver adapter (@prisma/adapter-neon) instead. See README → Deployment.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- API auth (apps/api) ---------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="dev-only-access-secret-change-me"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me"
ACCESS_TOKEN_TTL="900"           # seconds (15 min)
REFRESH_TOKEN_TTL="2592000"      # seconds (30 days)
OTP_TTL="600"                    # seconds (10 min)
OTP_MAX_ATTEMPTS="5"

# APP_ENV=local already echoes the freshly-issued OTP in register/resend/forgot
# responses (your machine, your call). OTP_DEBUG_ECHO forces the same on a
# `preview` env — DANGEROUS on anything internet-reachable, an echoed reset code
# is account takeover. Leave it unset unless you know exactly why.
# OTP_DEBUG_ECHO="false"
# On a deployed env: echo ONLY for these exact addresses (safe for a tiny closed
# beta). Comma-separated. Never list a real user here.
OTP_ECHO_EMAILS=""

# Allowed browser origins for the API (comma-separated). Unset = the genie web
# surfaces. The mobile app sends no Origin and is unaffected either way.
# CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# --- Email delivery (Resend) ----------------------------------
# https://resend.com — leave blank locally; OTP codes are logged to the console.
RESEND_API_KEY=""
EMAIL_FROM="genie <no-reply@genieapps.co>"

# --- File storage (Vercel Blob) -----------------------------------
# https://vercel.com/docs/storage/vercel-blob — needed for KYC docs & product images.
BLOB_READ_WRITE_TOKEN=""

# --- Payments (Anchor) ---------------------------------------
# PAYMENTS_PROVIDER=mock  → in-memory mock, no Anchor account needed (default for M1)
# PAYMENTS_PROVIDER=anchor → real calls to Anchor (requires ANCHOR_KEY)
PAYMENTS_PROVIDER="mock"
ANCHOR_BASE_URL="https://api.sandbox.getanchor.co/api/v1"
ANCHOR_KEY=""
ANCHOR_WEBHOOK_SECRET=""

# --- App URLs ------------------------------------------------
API_BASE_URL="http://localhost:8787"
NEXT_PUBLIC_API_BASE_URL="http://localhost:8787"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Admin portal (apps/admin) -------------------------------
ADMIN_SESSION_SECRET="dev-only-admin-session-secret-change-me"

# --- Mobile app (apps/mobile) -------------------------------
# Flutter reads this via --dart-define at build/run time, not from this file:
#   flutter run --dart-define=API_BASE_URL=http://10.0.2.2:8787
