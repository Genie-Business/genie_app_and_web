apps/mobile/*.iml
# android/ IS committed — it carries native edits `flutter create` can't supply:
# the INTERNET + biometric permissions and FlutterFragmentActivity. `flutter
# create .` still runs (locally + CI) to fill any gaps; it never overwrites
# committed files. Its own apps/mobile/android/.gitignore keeps build output,
# local.properties, the gradle wrapper jar and keystores out.
apps/mobile/ios/
apps/mobile/web/
apps/mobile/linux/
apps/mobile/macos/
apps/mobile/windows/

# vercel
.vercel
