# Copy to .env.local. The admin portal (served at http://admin.localhost:3000 in dev) is
# server-only and low-traffic, so it uses the DIRECT Neon connection (no "-pooler" in the host).
NEXT_PUBLIC_API_BASE_URL="http://localhost:8787"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Hostnames that serve the admin portal instead of the public site (comma-separated).
ADMIN_HOSTS="admin.localhost"
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"
ADMIN_SESSION_SECRET="change-me"
