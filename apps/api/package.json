{
  "name": "@genie/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --env-file-if-exists=.env.local src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc --noEmit && npm run openapi && npm run build:vercel",
    "build:vercel": "node scripts/build-vercel.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi": "tsx scripts/gen-openapi.ts"
  },
  "dependencies": {
    "@genie/contracts": "*",
    "@genie/core": "*",
    "@genie/db": "*",
    "@hono/zod-openapi": "^0.18.3",
    "@vercel/blob": "^0.27.0",
    "hono": "^4.6.16",
    "jose": "^5.9.6",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@genie/config": "*",
    "@hono/node-server": "^1.13.7",
    "@types/node": "^22.10.5",
    "esbuild": "^0.24.0",
    "eslint": "^9.17.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
