{
  "// dart/flutter": "The Flutter app lives in apps/mobile. This SDK path is the local clone; if you move it, update this or add <sdk>/bin to PATH.",
  "dart.flutterSdkPath": "C:\\Documents\\Flutter\\flutter",
  "dart.projectSearchDepth": 3,
  "dart.previewFlutterUiGuides": true,
  "dart.openDevTools": "flutter",
  "[dart]": {
    "editor.formatOnSave": true,
    "editor.rulers": [100],
    "editor.selectionHighlight": false,
    "editor.tabCompletion": "onlySnippets",
    "editor.wordBasedSuggestions": "off"
  },
  "files.watcherExclude": {
    "**/.dart_tool/**": true,
    "**/build/**": true,
    "**/android/.gradle/**": true,
    "**/node_modules/**": true,
    "**/.turbo/**": true
  },
  "search.exclude": {
    "**/apps/mobile/android": true,
    "**/apps/mobile/ios": true,
    "**/apps/mobile/build": true,
    "**/.dart_tool": true,
    "**/openapi.json": true
  }
}
